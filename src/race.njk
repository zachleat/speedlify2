<header class="detail-head">
	<h2 class="page-hed">Compare</h2>
	<p class="lede">
		Two sites drawing side by side, replayed from the filmstrips Lighthouse
		captured while measuring them. The clock is the load that was actually
		recorded, so a lane that is further along really did get there first.
	</p>
</header>

{#
	The unscripted state, and the error state, are the same message: the animation
	is the page. Replaced by the race itself once the catalog has loaded, so a
	reader whose script never arrived is told where the frames are instead of
	being left with dead controls.
#}
<div class="panel race-fallback" id="race-fallback">
	<p id="race-fallback-text">
		This page animates two filmstrips against each other, which needs
		JavaScript. Each site's own filmstrip is on its site page, linked from
		<a href="/">the leaderboard</a>.
	</p>
</div>

<div class="race" id="race" hidden>
	<form class="panel race-picker" id="race-picker" autocomplete="off">
		{#
			First, because it governs everything under it: the lanes, the names
			offered, and the categories worth listing all come from one capture or
			the other. Two sites measured under different throttling are two
			different connections, and laying them on one axis would show the
			unthrottled one finishing far sooner for no reason but how it was
			measured. Hidden while the corpus holds only one kind — a control with
			nothing to choose between.
		#}
		<fieldset class="race-throttle" id="race-throttle" hidden>
			<legend>Capture</legend>
			{#
				The same two marks the site pages put on a filmstrip, so the control
				and the label it selects for read as one idea. Decorative: the word
				beside each carries the meaning.
			#}
			<label>
				<input type="radio" name="race-throttle" value="false" checked>
				Unthrottled <span class="tag-mark" aria-hidden="true">🐇</span>
				<span class="race-throttle-count" data-capture="false"></span>
			</label>
			<label>
				<input type="radio" name="race-throttle" value="true">
				Throttled <span class="tag-mark" aria-hidden="true">🐢</span>
				<span class="race-throttle-count" data-capture="true"></span>
			</label>
		</fieldset>

		<div class="race-fields" id="race-fields"></div>
		{#
			One list for every lane. The value people type is the site's display
			URL; the address carries slugs, which is what /site/<slug>/ uses.
		#}
		<datalist id="race-catalog"></datalist>
		{#
			The trash mark, rendered once here so the Font Awesome transform can turn
			it into a `<use>` against this page's spritesheet and the symbol gets
			bundled. The lane rows are built in the browser and cannot call a
			build-time shortcode, so each Remove button clones this instead of
			carrying its own copy of the path data.
		#}
		<span class="race-icon-source" hidden>
			<i class="fa-solid fa-trash-can" width="14" height="14" aria-hidden="true"></i>
		</span>
		<span class="race-icon-source-lock" hidden>
			<i class="fa-solid fa-lock" width="14" height="14" aria-hidden="true"></i>
		</span>
		<span class="race-icon-source-unlock" hidden>
			<i class="fa-solid fa-lock-open" width="14" height="14" aria-hidden="true"></i>
		</span>
		<span class="race-icon-source-anim" hidden>
			<i class="fa-solid fa-arrows-rotate" width="10" height="10" aria-hidden="true"></i>
		</span>
		<span class="race-icon-source-finish" hidden>
			<i class="fa-solid fa-flag-checkered" width="10" height="10" aria-hidden="true"></i>
		</span>
		<div class="race-picker-actions">
			<button type="button" id="race-add">Add a lane</button>
			<button type="button" id="race-shuffle">Shuffle</button>
			{#
				Narrows what Shuffle draws from. Not part of the race itself — the
				address carries the sites, not how they were chosen — so it is a
				control rather than state, and it is populated from the catalog
				because only categories that actually have filmstrips can be raced.
			#}
			<label class="race-category">
				from
				<select id="race-category"><option value="">all categories</option></select>
			</label>
			<span class="race-count muted small" id="race-count"></span>
		</div>
	</form>

	<div class="race-controls">
		<button type="button" class="race-play" id="race-play">Start</button>
		<button type="button" id="race-restart">Reset</button>
		<label class="race-speed">
			Speed
			<select id="race-speed">
				<option value="0.25">0.25&times;</option>
				<option value="0.5">0.5&times;</option>
				<option value="1" selected>1&times; real time</option>
				<option value="2">2&times;</option>
				<option value="4">4&times;</option>
			</select>
		</label>
		<output class="race-clock" id="race-clock">0 ms</output>
	</div>

	<input type="range" class="race-scrub" id="race-scrub" min="0" max="1000" value="0" step="1"
		aria-label="Scrub through the comparison">

	<div class="race-scroll" id="race-scroll">
		<div class="race-grid" id="race-grid"></div>
	</div>

	<p class="race-result" id="race-result" role="status"></p>

	<p class="muted small race-note">
		Frames are thumbnails from the median Lighthouse run on the emulated
		{{ sites.config.formFactor }} profile, timed from navigation start and
		resampled here onto one shared grid, since each run samples on its own
		schedule. The clock is that recorded load. Each strip is only eight samples
		of its own run, and Lighthouse sizes that run's timeline to the run, so a
		lane simply stops where its capture stops rather than holding its last
		frame across an axis built for a longer one.
	</p>
	{#
		Two accounts of the same page, one per capture, swapped by the control at
		the top of the form. They cannot be one paragraph hedged both ways: the
		unthrottled note exists to warn that the frames are faster than any visitor
		would see, and the throttled one exists to say the opposite.
	#}
	<div id="race-note-unthrottled">
	<p class="muted small race-note">
		<strong>These frames are barely throttled.</strong> The runs use Lighthouse's
		default simulated throttling, which does not slow the connection or the
		processor: it clears network throttling before the load and never applies
		CPU throttling at all. Device emulation is real &mdash; a phone-sized
		viewport and a mobile user agent, so this is genuinely the
		{{ sites.config.formFactor }} layout &mdash; but the page otherwise arrives
		as fast as the measuring machine and its connection allow. The one
		exception is <code>requestIdleCallback</code>, which Lighthouse shims to
		hand back a quarter of its usual budget per callback, so a page that
		schedules work that way does spread it thinner here than it would on your
		machine.
	</p>
	<p class="muted small race-note">
		Slow 4G and a 4&times; CPU slowdown are applied afterwards instead, by
		Lighthouse's Lantern model, as an estimate of what that load would have
		been over a slow connection. That is where TTFB, FCP and LCP come from, and
		it is why none of them are drawn on this axis: the frames are one load and
		those numbers describe a different, slower one that never actually ran.
		Both are correct about different things, and no offset reconciles them: a
		page can be fully painted in these frames well before the FCP it reports.
		So the finish line here is the observed one:
		when a lane's picture stops changing. The rings beside each lane are that
		site's scores, which are about the site rather than about this clock. This
		is a picture of two measurements, not a benchmark.
	</p>
	</div>

	<div id="race-note-throttled" hidden>
	<p class="muted small race-note">
		<strong>These frames are of a throttled load.</strong> The runs applied
		Lighthouse's Slow 4G profile and a 4&times; CPU slowdown to the browser
		itself &mdash; not to a model afterwards &mdash; so the page arrived over a
		deliberately slow connection on a deliberately slow processor. What you are
		watching is much closer to what someone on a phone would sit through than
		an unthrottled capture is.
	</p>
	<p class="muted small race-note">
		The TTFB, FCP and LCP flags in each lane are observed in the same trace as
		its frames, so they line up with the pictures. They come from one throttled
		load, not the site's scored runs, so they can differ from the numbers on its
		site page. A close result is closer than it looks.
		The rings beside each lane are that site's scores, which are about the site
		rather than about this clock. This is a picture of two measurements, not a
		benchmark.
	</p>
	</div>
</div>

<script>
/*
 * The race. Everything here is client-side because the pairing is a query
 * parameter and the site is static: one built page has to serve every pairing.
 */
(function () {
	var root = document.getElementById("race");
	var fallback = document.getElementById("race-fallback");
	if (!root || !window.fetch || !window.Map) return;

	var MAX_LANES = 8;

	/*
	 * How far the frames shrink as lanes are added.
	 *
	 * Eight lanes at full size is a race nobody can see the end of without
	 * scrolling past the start of it. The floor matters as much as the curve:
	 * below about half size the label column's own contents set the row height
	 * anyway, so shrinking further costs legibility and buys nothing.
	 */
	function laneScale(count) {
		return Math.max(0.5, Math.min(1, 2.2 / count));
	}

	/*
	 * When the page stopped changing, read off the strip itself: the earliest
	 * frame from which every later frame is the same picture.
	 *
	 * This is the only "finished" this page can honestly draw. It is observed —
	 * it comes out of the same screenshots the lanes are made of — so it sits on
	 * the same clock they do. Lighthouse's own timings do not, which is why none
	 * of them appear on this page; see the note under the race.
	 */
	function settledAt(site) {
		var frames = (site && site.frames) || [];
		if (!frames.length) return null;

		/* Measured on the pixels at measurement time — see settleTime in
		   lib/metrics.js. Absent for strips captured before that landed, which
		   fall back to comparing filenames below: exact, and so blind to a page
		   that finished with one widget still moving. */
		if (typeof site.settledAt === "number") return site.settledAt;

		var last = frames[frames.length - 1].src;
		var at = frames[frames.length - 1].timing;
		for (var i = frames.length - 1; i >= 0; i--) {
			if (frames[i].src !== last) break;
			at = frames[i].timing;
		}
		return at;
	}

	/*
	 * Real-world durations to read the lanes against.
	 *
	 * The axis is never stretched to fit one; markers past the end of the race
	 * are not drawn. The longer ones only show up in throttled races.
	 */
	var COMPARISONS = [
		{ label: "👁 Human blink", at: 150 },
		/* 60 seconds over 70 beats. */
		{ label: "💓 Human heartbeat", at: 857 },
		/* 384,400 km at 299,792 km/s. */
		{ label: "🌕 Light from Moon to Earth", at: 1282 },
		/* 40,075 km of equator in one sidereal day — 465 m/s. */
		{ label: "🌍 Earth spins 1 km at the equator", at: 2150 },
		/* A mile at 343 m/s, the speed of sound at 20°C. */
		{ label: "🔊 Sound travels one mile", at: 4692 },
		{ label: "🍪 5s Rule", at: 5000 },
		{ label: "📹 Vine video", at: 6000 },
		{ label: "🏃 Usain Bolt runs 100m", at: 9580 },
		{ label: "🧼 Wash your Hands (CDC)", at: 20000 },
		{ label: "🏀 NBA shot clock", at: 24000 },
		{ label: "📺 TV Commercial", at: 30000 }
	];


	var grid = document.getElementById("race-grid");
	var scroll = document.getElementById("race-scroll");
	var fields = document.getElementById("race-fields");
	var catalogList = document.getElementById("race-catalog");
	var clock = document.getElementById("race-clock");
	var scrub = document.getElementById("race-scrub");
	var playButton = document.getElementById("race-play");
	var result = document.getElementById("race-result");
	var count = document.getElementById("race-count");

	var catalog = [];
	var bySlug = new Map();
	var byName = new Map();
	var lanes = [];
	/* Categories a random pairing may draw from — see api-race.njk. Empty means
	   no filter. */
	var categories = [];
	/* One of their ids, when Shuffle has been narrowed to a single category. */
	var shuffleCategory = "";
	/*
	 * Which capture the page is comparing: false for unthrottled, true for
	 * throttled. Every lane has to be one or the other — see `matchesCapture`.
	 */
	var captureMode = false;
	var compareMarkers = [];
	var timeline = null;
	var now = 0;
	var playing = false;
	var speed = 1;
	var raf = 0;
	var lastFrameTime = 0;
	var follow = true;

	/* ------------------------------------------------------------ formatting */

	function fmtMs(value) {
		if (typeof value !== "number") return "—";
		if (value >= 1000) return (value / 1000).toFixed(value >= 10000 ? 1 : 2) + " s";
		return Math.round(value) + " ms";
	}

	/* Seconds to two places — short enough to sit under a frame, precise enough
	   that two frames a sample apart do not read as the same instant. */
	function fmtSeconds(value) {
		if (typeof value !== "number") return "";
		return (value / 1000).toFixed(2) + "s";
	}

	function fmtClock(value) {
		return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + " ms";
	}

	/*
	 * The six band dots the Recently Measured lists draw, from the same
	 * `ringBands` the report uses — four Lighthouse categories, then axe, then
	 * Core Web Vitals.
	 *
	 * Dots rather than the leaderboard's rings: these sit inline beside a site
	 * name on one line, where six 24px circles would be the line rather than a
	 * detail on it.
	 */
	function bandDots(site) {
		var dots = el("span", "recents-dots");
		dots.setAttribute("aria-hidden", "true");
		dots.title = "Performance, Accessibility, Best Practices, SEO, Axe, Core Web Vitals";
		(site.bands || []).forEach(function (band) {
			dots.appendChild(el("span", "recents-dot recents-dot-" + band));
		});
		return dots;
	}

	/* The mark from the hidden source in the markup. Empty string if it is
	   missing, which leaves a button with a label and no icon rather than a
	   broken one. */
	function trashIcon() {
		var source = document.querySelector(".race-icon-source");
		return source ? source.innerHTML : "";
	}

	function finishIcon() {
		var source = document.querySelector(".race-icon-source-finish");
		return source ? source.innerHTML : "";
	}

	function animIcon() {
		var source = document.querySelector(".race-icon-source-anim");
		return source ? source.innerHTML : "";
	}

	function lockIcon(locked) {
		var source = document.querySelector(locked ? ".race-icon-source-lock" : ".race-icon-source-unlock");
		return source ? source.innerHTML : "";
	}

	function el(tag, className) {
		var node = document.createElement(tag);
		if (className) node.className = className;
		return node;
	}

	/* --------------------------------------------------------------- the axis */

	/*
	 * One grid for every lane.
	 *
	 * Lighthouse samples each run on its own schedule, so two strips laid out
	 * frame by frame are not comparable — the site sampled every 900ms would look
	 * slower than the one sampled every 375ms for no reason but the sampling. The
	 * strips are resampled onto a single step instead: column i shows whatever
	 * each site had painted by i steps in, which is the comparison the page
	 * claims to be making.
	 */
	function buildTimeline(racers) {
		var end = 0;
		var step = Infinity;

		racers.forEach(function (r) {
			var frames = r.frames || [];
			if (frames.length) end = Math.max(end, frames[frames.length - 1].timing);
			for (var i = 1; i < frames.length; i++) {
				var gap = frames[i].timing - frames[i - 1].timing;
				if (gap > 0) step = Math.min(step, gap);
			}
		});

		if (!isFinite(step) || step <= 0) step = 250;
		if (!end) end = step * 4;

		/*
		 * The step is the finest strip's own interval and nothing else.
		 *
		 * It used to be widened to hold the axis under a column cap, which made
		 * sense while frames were resampled into columns. Placed by timestamp they
		 * are laid out in stride units of this step, so widening it pulls them
		 * toward each other — at the extreme, a 45s race put its frames a fifth of
		 * a stride apart and they overlapped. The axis is as long as it needs to
		 * be instead, and scrolls.
		 */
		var cols = Math.max(1, Math.ceil(end / step));
		return { step: step, cols: cols, end: cols * step };
	}

	/*
	 * The last frame at or before `t`, as stored, or null where this strip has
	 * nothing to say about `t`.
	 *
	 * Lighthouse times its thumbnails from navigation start — it forces
	 * `timeOrigin` as speedline's reference point — so the stored timings need no
	 * correction to sit on this axis.
	 *
	 * A strip covers only its own eight samples, and every strip is a different
	 * length: Lighthouse divides that run's own timeline into eight, so racing a
	 * 3s capture against a 15s one leaves the shorter lane with nothing recorded
	 * for most of the axis. It stops there rather than holding its last frame
	 * across the gap, which would be showing a picture at a time nobody
	 * photographed it.
	 */
	function frameAt(racer, t, step) {
		var frames = racer.frames || [];
		if (!frames.length) return null;

		/*
		 * One column past the strip's end, not zero.
		 *
		 * A column stands for the interval that ends at `t`, and the grid runs on
		 * the finest step in the race, so a strip's last frame almost never lands
		 * on a column boundary. Cutting at `t > last` therefore dropped the final
		 * frame outright whenever it fell between two columns — which is the one
		 * frame that matters, the finished page. salesforce.com's strip ends at
		 * 4806ms and on a 375ms grid the columns either side are 4500 and 4875, so
		 * its render was never drawn at all.
		 *
		 * The strip is shown through the column whose interval contains its end,
		 * and goes dark after that.
		 */
		var last = frames[frames.length - 1].timing;
		if (t - step >= last) return null;

		var hit = null;
		for (var i = 0; i < frames.length; i++) {
			if (frames[i].timing > t) break;
			hit = frames[i];
		}
		return hit;
	}

	/* ------------------------------------------------------------- the lanes */

	function renderGrid() {
		timeline = buildTimeline(lanes.map(function (l) { return l.site; }));
		grid.innerHTML = "";
		grid.style.setProperty("--cols", timeline.cols);

		/* Widest frame in the race sets the column, so lanes stay in step even
		   when two sites were captured at different sizes. */
		var aspect = 0.5;
		lanes.forEach(function (lane) {
			var s = lane.site;
			if (s.width && s.height) aspect = Math.max(aspect, s.width / s.height);
		});
		root.style.setProperty("--race-aspect", aspect.toFixed(4));
		root.style.setProperty("--race-lane-scale", laneScale(lanes.length).toFixed(3));

		grid.appendChild(renderRuler());

		lanes.forEach(function (lane, index) {
			lane.index = index;
			/* Kept, so the clock can mark the winning row — see setTime. */
			lane.nameEl = renderName(lane);
			lane.laneEl = renderLane(lane);
			grid.appendChild(lane.nameEl);
			grid.appendChild(lane.laneEl);
		});

		renderComparisons();
		lanes.forEach(function (lane) { packRows(lane.markers); });
		renderResult(null);
		observeLanes();
	}

	/* One row of flags, above the lanes they are there to be read against. */
	/*
	 * One row of flags, above the lanes they are there to be read against.
	 *
	 * Built after the lanes and inserted in front of them, because packing the
	 * labels needs a rendered frame to measure the column stride from.
	 */
	function renderComparisons() {
		compareMarkers = [];

		var name = el("div", "race-name is-compare");
		var inner = el("span", "race-sticky");
		var title = el("span", "race-name-link");
		title.textContent = "Real world";
		inner.appendChild(title);
		name.appendChild(inner);

		var lane = el("div", "race-lane is-compare");
		var built = [];

		COMPARISONS.forEach(function (item) {
			/* Off the end of this race — see COMPARISONS. */
			if (item.at > timeline.end) return;

			/* Pole and label as siblings under a wrapper that carries neither
			   z-index nor opacity: anything on the wrapper would make a stacking
			   context and trap the label inside it, leaving every label to be
			   crossed by the poles of the flags after it. */
			var marker = el("div", "race-flagpost");
			marker.style.setProperty("--at", item.at / timeline.step);

			marker.appendChild(el("i", "race-flagpost-pole"));

			var label = el("span", "race-flagpost-label");
			label.style.setProperty("--row", 0);
			label.textContent = item.label + " · " + fmtMs(item.at);
			marker.appendChild(label);
			lane.appendChild(marker);

			built.push({ at: item.at, label: label });
			compareMarkers.push({ el: marker, time: item.at });
		});

		var firstLane = grid.querySelector(".race-name");
		grid.insertBefore(name, firstLane);
		grid.insertBefore(lane, firstLane);

		packFlags(built, lane, name);
	}

	// Observed TTFB, FCP and LCP from the pass that took the frames; metrics that coincide share a flag.
	function renderMarkers(site, cell) {
		var markers = site.markers || {};
		var byTime = [];
		[["ttfb", "TTFB"], ["fcp", "FCP"], ["lcp", "LCP"]].forEach(function (pair) {
			var at = markers[pair[0]];
			if (typeof at !== "number" || at > timeline.end) return;
			var same = byTime.filter(function (m) { return m.at === at; })[0];
			if (same) same.names.push(pair[1]);
			else byTime.push({ at: at, names: [pair[1]] });
		});
		byTime.sort(function (a, b) { return a.at - b.at; });

		return byTime.map(function (item) {
			var marker = el("div", "race-flagpost is-metric");
			marker.style.setProperty("--at", item.at / timeline.step);
			marker.appendChild(el("i", "race-flagpost-pole"));
			var label = el("span", "race-flagpost-label");
			label.style.setProperty("--row", 0);
			label.textContent = item.names.join(" · ") + " " + fmtSeconds(item.at);
			label.title = "Observed in this throttled capture, not the site's scored runs";
			marker.appendChild(label);
			cell.appendChild(marker);
			return { el: marker, time: item.at, at: item.at, label: label };
		});
	}

	/*
	 * Put each flag on the highest row where its label clears the one before it.
	 *
	 * Measured rather than estimated. A label's width is pixels and the gap
	 * between two flags is time, and the exchange rate between them — the column
	 * stride — is not fixed: frames shrink as lanes are added, so the same two
	 * moments that clear each other in a two-lane race collide in an eight-lane
	 * one. Reading the real stride and the real label widths is the only version
	 * of this that holds at every size.
	 */
	function packFlags(built, lane, name) {
		var used = packRows(built);
		lane.style.setProperty("--rows", used);
		name.style.setProperty("--rows", used);
	}

	function packRows(built) {
		var stride = strideWidth() || 90;
		/* Right edge of the last label on each row. */
		var edges = [];
		var used = 1;

		built.forEach(function (flag) {
			var x = (flag.at / timeline.step) * stride;
			var width = flag.label.offsetWidth || 120;
			var row = 0;

			while (edges[row] !== undefined && x < edges[row]) row += 1;

			/* A few pixels of daylight, so two labels never sit edge to edge. */
			edges[row] = x + width + 6;
			flag.label.style.setProperty("--row", row);
			used = Math.max(used, row + 1);
		});

		return used;
	}

	/*
	 * Tick intervals worth reading a clock against, coarsest last.
	 *
	 * The ruler used to tick once per column, at Lighthouse's own sampling
	 * interval — so it read 375ms, 750ms, 1.13s, and changed shape between
	 * comparisons because that interval is a property of each run's timeline
	 * rather than of time. These are the same numbers a clock has.
	 */
	var TICK_STEPS = [100, 250, 500, 1000, 2000, 2500, 5000, 10000, 15000, 30000];
	var MAX_TICKS = 12;

	/*
	 * Never finer than the frames it is measuring.
	 *
	 * The default strip is eight samples across Lighthouse's three-second minimum
	 * — one every 375ms — and a 250ms tick out-resolves that: three ticks for
	 * every two photographs, implying a precision the pictures do not have. The
	 * tick is the coarsest of two floors, the grid's own cadence and whatever
	 * keeps the count readable.
	 */
	function tickStep(end, step) {
		for (var i = 0; i < TICK_STEPS.length; i++) {
			if (TICK_STEPS[i] < step) continue;
			if (end / TICK_STEPS[i] <= MAX_TICKS) return TICK_STEPS[i];
		}
		return TICK_STEPS[TICK_STEPS.length - 1];
	}

	/*
	 * Ticks at round times, positioned the way the comparison flags are: a
	 * fraction of the column stride rather than a column index.
	 *
	 * They no longer line up with frame boundaries, which is the honest
	 * arrangement — the frames are not at round times, and a tick sitting exactly
	 * on every column edge quietly claimed the sampling grid was the clock.
	 */
	function renderRuler() {
		var ruler = el("div", "race-ruler");
		var step = tickStep(timeline.end, timeline.step);

		for (var at = step; at <= timeline.end; at += step) {
			var tick = el("span", "race-tick");
			tick.style.setProperty("--at", at / timeline.step);
			tick.textContent = fmtMs(at);
			ruler.appendChild(tick);
		}
		return ruler;
	}

	/*
	 * The label above a lane, on its own line.
	 *
	 * A row of its own rather than a column beside the frames: the frames are the
	 * page, and a name column takes width away from them at every viewport while
	 * a line of text costs one line. The inner run sticks to the left edge so the
	 * name stays readable however far the lane has scrolled.
	 */
	function renderName(lane) {
		var row = el("div", "race-name");
		row.style.setProperty("--lane", lane.index);

		var inner = el("span", "race-sticky");

		var title = el("a", "race-name-link");
		title.href = "/site/" + encodeURIComponent(lane.site.slug) + "/";
		title.textContent = lane.site.name;
		inner.appendChild(title);

		inner.appendChild(bandDots(lane.site));

		lane.flag = el("span", "race-flag");
		lane.flag.textContent = "🏁";
		inner.appendChild(lane.flag);

		row.appendChild(inner);
		return row;
	}

	/*
	 * A lane: every frame at the moment it was taken, and one live frame that
	 * rides the clock.
	 *
	 * Frames are placed by their own timing rather than dropped into columns.
	 * Columns were a resampling — a coarsely sampled lane repeated its last frame
	 * into every slot, which drew pictures at times nobody photographed them.
	 * Here a frame sits exactly where its timestamp falls and the gaps between
	 * them are real: they are the stretches this strip has nothing to say about.
	 *
	 * The live frame is the animation. It moves continuously with the clock,
	 * carrying whatever the page looked like at that instant, and each time it
	 * passes a frame's own moment that frame is left behind at it. So the strip
	 * assembles as the clock runs rather than appearing a column at a time.
	 */
	/*
	 * When the space between two frames is drawn as unphotographed.
	 *
	 * Any time they are more than one sample apart, which is the same rule as
	 * "more than `--race-gap` of clear space": the stride is a frame's width plus
	 * that gap, so two frames a single sample apart sit exactly that far from
	 * each other and anything wider is a stretch nobody photographed. The epsilon
	 * is for the lane that set the step, whose ratio is 1 by construction and
	 * must not round its way into a band.
	 */
	var WAITING_GAP = 1 + 1e-9;

	function renderLane(lane) {
		var cell = el("div", "race-lane");
		cell.style.setProperty("--lane", lane.index);

		var frames = lane.site.frames || [];
		var settled = settledAt(lane.site);

		lane.gaps = [];

		/* Before the first sample. One band rather than a row of placeholders: the
		   whole stretch is a single fact — nothing was captured yet — and drawing
		   it as frames would invent a sampling rate for it. */
		if (frames.length && frames[0].timing > 0) {
			var lead = el("div", "race-waiting is-lead");
			lead.style.setProperty("--from", 0);
			lead.style.setProperty("--to", frames[0].timing / timeline.step);
			lead.style.setProperty("--fill", 0);
			cell.appendChild(lead);
			lane.gaps.push({ el: lead, from: 0, to: frames[0].timing });
		}

		/*
		 * And between samples, wherever the strip skipped enough time to show it.
		 *
		 * A lane sampled more coarsely than the grid leaves real space between its
		 * frames — those are stretches of the load nobody photographed, and the
		 * same band says so as says it at the head of the lane. Below the
		 * threshold the frames are close enough to read as a sequence and a sliver
		 * of hatching between them would be noise.
		 */
		for (var g = 1; g < frames.length; g++) {
			var from = frames[g - 1].timing;
			var to = frames[g].timing;
			if ((to - from) / timeline.step <= WAITING_GAP) continue;
			/* No band into a frame that is not drawn — see the settle skip below. */
			if (typeof settled === "number" && from >= settled) continue;

			/*
			 * Tiled with the frame that opened the gap.
			 *
			 * Between two samples the page is not unknown, it is unobserved: the
			 * last thing anyone saw is still the best account of it. Repeating that
			 * picture across the band says "as last seen, still" — and repeating it
			 * faintly, behind a dashed edge, keeps it from being mistaken for the
			 * photographs either side, which is what the old column-repeat did
			 * wrong. The lead band gets none of this: before the first sample there
			 * is genuinely nothing to carry forward.
			 */
			var band = el("div", "race-waiting is-held");
			band.style.setProperty("--from", from / timeline.step);
			band.style.setProperty("--to", to / timeline.step);
			band.style.setProperty("--fill", from / timeline.step);
			/* Handed to CSS as a property rather than set as the background here:
			   the picture is painted by a masked layer inside the band, so the band
			   itself can stay transparent. */
			band.style.setProperty("--held-src", "url(" + frames[g - 1].src + ")");
			band.title = "Not captured — the page as last seen, at " + fmtMs(from);
			cell.appendChild(band);
			lane.gaps.push({ el: band, from: from, to: to });
		}

		lane.cells = [];
		frames.forEach(function (frame, index) {
			var slot = el("div", "race-frame");
			slot.style.setProperty("--at", frame.timing / timeline.step);

			// The frame the lane finishes on.
			if (typeof settled === "number" && frame.timing === settled) {
				var flag = el("span", "race-frame-finish");
				flag.innerHTML = finishIcon();
				flag.title = "Finished — the page stopped changing here, at " + fmtSeconds(frame.timing);
				slot.appendChild(flag);
			}

			/* Past the point the picture stopped changing, every remaining frame is
			   the settled one again. Drawn, because they were measured and the
			   lane's length is part of what it says — but faint, so the eye stays
			   on the part of each lane that is still changing. */
			if (typeof settled === "number" && frame.timing > settled) {
				slot.classList.add("is-settled");

				/*
				 * Settled, but not still.
				 *
				 * The settle is judged on the pixels with room for a small change —
				 * see settleTime in lib/metrics.js — so a page can be finished while
				 * something on it keeps moving: a carousel, a spinner, a looping
				 * video. A frame after the settle that differs from the one before it
				 * is that, and it gets a mark saying so, rather than being faded
				 * into the same "nothing more here" as a true repeat.
				 */
				var prev = index > 0 ? frames[index - 1] : null;
				if (prev && prev.src !== frame.src) {
					var anim = el("span", "race-frame-anim");
					anim.innerHTML = animIcon();
					anim.title = "Still animating — this frame differs from the one before, after the page had settled";
					slot.appendChild(anim);
				}
			}

			var img = new Image();
			img.src = frame.src;
			img.alt = "";
			img.decoding = "async";
			slot.appendChild(img);

			/* When this one was taken, under it. The ruler gives the axis its
			   scale; this gives each picture its own moment, which is the thing
			   being compared and is otherwise read off by eye against a tick. */
			var stamp = el("span", "race-frame-time");
			stamp.textContent = fmtSeconds(frame.timing);
			slot.appendChild(stamp);

			cell.appendChild(slot);
			lane.cells.push({ el: slot, time: frame.timing });
		});

		/*
		 * The travelling frame. Positioned by the clock rather than by a timestamp,
		 * and hidden once the strip runs out — past its last sample there is
		 * nothing to carry.
		 */
		if (frames.length) {
			lane.live = el("div", "race-frame race-live");
			lane.liveImg = new Image();
			lane.liveImg.alt = "";
			lane.liveImg.decoding = "async";
			lane.live.appendChild(lane.liveImg);
			cell.appendChild(lane.live);
		} else {
			lane.live = null;
			lane.liveImg = null;
		}

		lane.head = el("div", "race-playhead");
		cell.appendChild(lane.head);

		lane.markers = renderMarkers(lane.site, cell);

		return cell;
	}

	/* ------------------------------------------------------------- the clock */

	function setTime(t) {
		now = Math.max(0, Math.min(t, timeline.end));
		clock.textContent = fmtClock(now);
		if (document.activeElement !== scrub) {
			scrub.value = String(Math.round((now / timeline.end) * 1000));
		}

		compareMarkers.forEach(function (marker) {
			marker.el.classList.toggle("is-on", marker.time <= now);
		});
		lanes.forEach(function (lane) {
			(lane.markers || []).forEach(function (marker) {
				marker.el.classList.toggle("is-on", now > 0 && marker.time <= now);
			});
		});

		var best = null;
		lanes.forEach(function (lane) {
			lane.cells.forEach(function (cell) {
				cell.el.classList.toggle("is-on", cell.time <= now);
			});
			/*
			 * A gap grows with the clock rather than appearing whole.
			 *
			 * Drawn at full length the moment the clock entered it, a band showed
			 * how long the wait would be before the wait had happened — the one
			 * thing on the page reporting the future. Its right edge is the clock
			 * now, so it fills as the time passes and stops at the frame that ends
			 * it. Nothing opens at rest either: the lead band starts at zero, and
			 * at a standstill it would be the only mark on an empty track.
			 */
			lane.gaps.forEach(function (gap) {
				var reached = Math.max(gap.from, Math.min(now, gap.to));
				gap.el.style.setProperty("--fill", reached / timeline.step);
				gap.el.classList.toggle("is-on", now > gap.from);
			});
			/* The line keeps the clock's own position in every lane, finished or
			   not — the lanes share one clock, and a line that stopped in one of
			   them broke that. Past the lane's finish it fades back instead: still
			   the time, no longer anything happening here. */
			var finish = laneFinish(lane);
			lane.head.classList.toggle("is-on", now > 0);
			lane.head.classList.toggle("is-done", now > finish);
			lane.head.style.setProperty("--now", now / timeline.step);
			moveLive(lane);

			var settled = settledAt(lane.site);
			if (typeof settled === "number" && settled <= now &&
				(best === null || settled < best)) {
				best = settled;
			}
		});

		/* The flag goes to whoever stopped changing first, as soon as the clock
		   says so rather than at the end.

		   Every lane on the leading time, not the first one found: strips are
		   sampled coarsely and a fifth of all pairings settle on the same frame,
		   where picking one would be inventing a winner out of lane order. */
		lanes.forEach(function (lane) {
			var settled = settledAt(lane.site);
			var won = best !== null && settled === best && lanes.length > 1;
			lane.flag.classList.toggle("is-on", won);
			/* The whole row, not just the flag: a 🏁 in the label column is easy to
			   miss in an eight-lane race. `toggle` with a value is idempotent, so a
			   row that is already the winner does not restart the animation on
			   every frame — only crossing the line, or scrubbing back over it,
			   plays it again. */
			lane.nameEl.classList.toggle("is-winner", won);
			lane.laneEl.classList.toggle("is-winner", won);
		});

		if (follow) followPlayhead();
	}

	/*
	 * Carry the live frame to wherever the clock is.
	 *
	 * It shows the last frame taken at or before now — the same lookup the
	 * deposited frames answer statically — so as it crosses each timestamp the
	 * picture it carries is already the one being left behind there. Past the end
	 * of the strip it has nothing to show and steps aside.
	 */
	/* When a lane is over: its settle if it has one, otherwise its last sample.
	   The same point the frames stop at, so the line lands with them. */
	function laneFinish(lane) {
		var settled = settledAt(lane.site);
		if (typeof settled === "number") return settled;
		var frames = lane.site.frames || [];
		return frames.length ? frames[frames.length - 1].timing : 0;
	}

	function moveLive(lane) {
		if (!lane.live) return;

		var frame = frameAt(lane.site, now, timeline.step);
		var last = lane.site.frames[lane.site.frames.length - 1];
		var settled = settledAt(lane.site);
		/* Retired at the settle for the same reason the repeats are not drawn: a
		   frame still travelling over a finished lane reads as a page still
		   loading. */
		var gone = now > last.timing || (typeof settled === "number" && now > settled);

		/*
		 * Shown from the moment the clock starts, with or without a picture in it.
		 *
		 * Before the first sample there is nothing to carry, but the frame is still
		 * travelling — and an empty outline moving down the track says that much
		 * better than nothing does: the load has begun, it just has not been
		 * photographed yet. Popping into existence at the first sample made the
		 * lane look as though it started there.
		 */
		lane.live.classList.toggle("is-on", now > 0 && !gone);
		if (gone || now <= 0) return;

		lane.live.classList.toggle("is-empty", !frame);
		if (frame && lane.liveImg.getAttribute("src") !== frame.src) lane.liveImg.src = frame.src;
		lane.live.style.setProperty("--at", now / timeline.step);
	}

	function followPlayhead() {
		var stride = strideWidth();
		if (!stride) return;
		var x = (now / timeline.step) * stride;
		var target = x - scroll.clientWidth * 0.6;
		if (target > scroll.scrollLeft) scroll.scrollLeft = target;
	}

	/*
	 * Pixels per column step, measured rather than recomputed.
	 *
	 * Taken off the ruler, which is exactly `stride × cols` wide: reading the
	 * custom property back gives an unresolved `calc()` in some browsers, and
	 * rebuilding the sum here means two places to change every time the spacing
	 * does — which is how this last went out of step, still adding a gap to one
	 * frame width after the stride had become two.
	 */
	function strideWidth() {
		var ruler = grid.querySelector(".race-ruler");
		if (!ruler || !timeline || !timeline.cols) return 0;
		return ruler.getBoundingClientRect().width / timeline.cols;
	}

	function tick(stamp) {
		if (!playing) return;
		var delta = lastFrameTime ? stamp - lastFrameTime : 0;
		lastFrameTime = stamp;
		setTime(now + delta * speed);
		if (now >= timeline.end) {
			pause();
			renderResult(rank());
			return;
		}
		raf = requestAnimationFrame(tick);
	}

	function play() {
		if (playing) return;
		if (now >= timeline.end) restart();
		/* Any start is a fresh decision, so a pause the page made on its own no
		   longer applies. */
		autoPaused = false;
		playing = true;
		follow = true;
		lastFrameTime = 0;
		playButton.textContent = "Pause";
		raf = requestAnimationFrame(tick);
	}

	/*
	 * Stop the clock while nobody can see it, and pick it back up when they can.
	 *
	 * Two ways out of sight: the comparison scrolled off the screen, or the tab in
	 * the background. The second was also a bug — animation frames stop in a
	 * background tab, so the first one back measured the whole absence as a
	 * single frame's worth of elapsed time and the race leapt to its end.
	 *
	 * Only a pause this made is undone by this. A reader who paused it themselves
	 * wants it to stay paused, and coming back to the tab is not a request to
	 * start again.
	 */
	var autoPaused = false;
	var inView = true;
	/* The racer lanes currently on screen — see observeLanes. */
	var visibleLanes = new Set();
	var laneObserver = null;

	function syncVisibility() {
		var showing = inView && document.visibilityState !== "hidden";
		if (!showing && playing) {
			pause();
			autoPaused = true;
		} else if (showing && autoPaused) {
			autoPaused = false;
			if (now < timeline.end) play();
		}
	}

	/*
	 * Watched per lane rather than as one scroll area.
	 *
	 * The scroll area holds the ruler, the reference row and every label as well,
	 * so any of those on screen counted as the comparison being visible — a race
	 * would keep running with nothing but the ruler in view. What matters is
	 * whether any of the frames are, so this counts the racer lanes themselves
	 * and runs while at least one is on screen.
	 */
	function watchVisibility() {
		document.addEventListener("visibilitychange", syncVisibility);
		if (!window.IntersectionObserver) return;
		laneObserver = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) visibleLanes.add(entry.target);
				else visibleLanes.delete(entry.target);
			});
			inView = visibleLanes.size > 0;
			syncVisibility();
		}, { threshold: 0 });
		observeLanes();
	}

	/* The lanes are rebuilt on every render, so the observer is pointed at the
	   new ones each time rather than left watching elements that are gone. */
	function observeLanes() {
		if (!laneObserver) return;
		laneObserver.disconnect();
		visibleLanes.clear();
		lanes.forEach(function (lane) {
			if (lane.laneEl) laneObserver.observe(lane.laneEl);
		});
	}

	function pause() {
		playing = false;
		cancelAnimationFrame(raf);
		playButton.textContent = now >= timeline.end ? "Replay" : now > 0 ? "Resume" : "Start";
	}

	function restart() {
		cancelAnimationFrame(raf);
		playing = false;
		follow = true;
		scroll.scrollLeft = 0;
		setTime(0);
		playButton.textContent = "Start";
		renderResult(null);
	}

	/* ------------------------------------------------------------ the result */

	/* Ranked on the axis the race is actually run on: when each lane's picture
	   stopped changing. */
	function rank() {
		return lanes
			.filter(function (l) { return typeof settledAt(l.site) === "number"; })
			.slice()
			.sort(function (a, b) { return settledAt(a.site) - settledAt(b.site); });
	}

	function renderResult(ranked) {
		/* Emptied rather than hidden: the line holds its own height from the
		   start, so arriving at the end does not shove the note under it down the
		   page just as someone is reading the finish. */
		if (!ranked || ranked.length < 2) {
			result.textContent = "";
			return;
		}
		var winner = ranked[0];
		var next = ranked[1];
		var winnerAt = settledAt(winner.site);
		var margin = settledAt(next.site) - winnerAt;

		if (margin > 0) {
			result.innerHTML = "🏁 <strong>" + escapeHtml(winner.site.name) +
				"</strong> stopped changing first, at " + fmtMs(winnerAt) + " — " +
				fmtMs(margin) + " ahead of " + escapeHtml(next.site.name) + ".";
			return;
		}

		/* A dead heat is the honest reading when both settled on the same sample,
		   which the strips are too coarse to separate. */
		var tied = ranked.filter(function (l) { return settledAt(l.site) === winnerAt; });
		result.innerHTML = "🏁 Dead heat at " + fmtMs(winnerAt) + " — " +
			tied.map(function (l) { return "<strong>" + escapeHtml(l.site.name) + "</strong>"; }).join(" and ") +
			" both settled on the same frame.";
	}

	function escapeHtml(value) {
		return String(value).replace(/[&<>"]/g, function (c) {
			return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
		});
	}

	/* ------------------------------------------------------------ the picker */

	function renderFields() {
		fields.innerHTML = "";

		/* Always at least two rows, however few lanes are filled. A single racer
		   with no second row would look like the page had lost a control rather
		   than like there being nothing to put in it. */
		var slots = Math.max(2, lanes.length);

		for (var slot = 0; slot < slots; slot++) {
			renderField(slot);
		}

		document.getElementById("race-add").disabled = lanes.length >= MAX_LANES;
	}

	function renderField(index) {
		var lane = lanes[index] || null;
		{
			var row = el("div", "race-field");

			var label = el("label", "race-field-label");
			label.htmlFor = "race-site-" + index;
			label.textContent = "Lane " + (index + 1);
			row.appendChild(label);

			var input = el("input", "race-field-input");
			input.id = "race-site-" + index;
			input.type = "text";
			input.setAttribute("list", "race-catalog");
			input.value = lane ? lane.site.name : "";
			if (!lane) input.placeholder = "nothing eligible yet";
			input.addEventListener("change", function () {
				var typed = input.value.trim();
				var match = byName.get(typed.toLowerCase()) || bySlug.get(typed);
				/* Refused rather than silently switching the whole field's capture
				   under the other lanes. */
				if (match && !matchesCapture(match)) match = null;
				if (!match) {
					input.setAttribute("aria-invalid", "true");
					return;
				}
				input.removeAttribute("aria-invalid");
				/* The lock belongs to the slot, so choosing a different site for a
				   locked lane keeps it locked. */
				lanes[index] = { site: match, locked: lane ? Boolean(lane.locked) : false };
				commit(true);
			});
			row.appendChild(input);

			/*
			 * Lock a lane to keep it through shuffles.
			 *
			 * A toggle rather than a checkbox: it changes what one button does to
			 * one lane, so it sits in that lane's row and says so in its pressed
			 * state. Toggling redraws the row and re-judges Shuffle and nothing
			 * else — it is not a change to the comparison, so it touches neither
			 * the address nor the animation.
			 */
			if (lane) {
				var lock = el("button", "race-field-lock");
				lock.type = "button";
				lock.innerHTML = lockIcon(lane.locked);
				lock.setAttribute("aria-pressed", lane.locked ? "true" : "false");
				var lockLabel = (lane.locked ? "Unlock" : "Lock") + " lane " + (index + 1);
				lock.title = lane.locked
					? lockLabel + " — Shuffle will replace it"
					: lockLabel + " — keep it when shuffling";
				lock.setAttribute("aria-label", lockLabel);
				lock.addEventListener("click", function () {
					lane.locked = !lane.locked;
					renderFields();
					updateShuffleState();
				});
				row.appendChild(lock);
				row.classList.toggle("is-locked", Boolean(lane.locked));
			}

			/* Lane 1 is kept until there are lanes to spare; any lane after it can go,
			   down to a field of one — which is a real state now, not a broken one. */
			if (lane && (lanes.length > 2 || index > 0)) {
				var remove = el("button", "race-field-remove");
				remove.type = "button";
				remove.innerHTML = trashIcon();
				remove.title = "Remove lane " + (index + 1);
				remove.setAttribute("aria-label", "Remove lane " + (index + 1));
				remove.addEventListener("click", function () {
					lanes.splice(index, 1);
					commit(true);
				});
				row.appendChild(remove);
			}

			fields.appendChild(row);
		}
	}

	/* ---------------------------------------------------------- the address */

	function slugs() {
		return lanes.map(function (l) { return l.site.slug; });
	}

	function readAddress() {
		var params = new URLSearchParams(location.search);
		var raw = params.get("sites") || "";
		return raw.split(",").map(function (s) { return s.trim(); }).filter(Boolean);
	}

	function writeAddress(push) {
		var query = "?sites=" + slugs().map(encodeURIComponent).join(",");
		/* Only when it is not the default, so an ordinary link stays short and a
		   shared one carries the speed only because someone chose it. */
		if (speed !== 1) query += "&speed=" + speed;

		var next = location.pathname + query;
		if (push) history.pushState(null, "", next);
		else history.replaceState(null, "", next);
	}

	/*
	 * The speed from the address, if it names one the control offers.
	 *
	 * Checked against the select's own options rather than a list repeated here:
	 * a query can say anything, and an arbitrary multiplier is a way to hand
	 * someone a race that runs at 1000x or backwards.
	 */
	function readSpeed() {
		var raw = new URLSearchParams(location.search).get("speed");
		var value = parseFloat(raw);
		if (!isFinite(value)) return 1;

		var select = document.getElementById("race-speed");
		for (var i = 0; i < select.options.length; i++) {
			if (parseFloat(select.options[i].value) === value) return value;
		}
		return 1;
	}

	/* Address to control and variable, in one place — used on load and on Back. */
	function applySpeed() {
		speed = readSpeed();
		document.getElementById("race-speed").value = String(speed);
		lastFrameTime = 0;
	}

	/* Rebuild everything from `lanes`, and record it. `push` distinguishes a
	   choice someone made — which belongs in history — from the page settling on
	   a default, which does not. */
	function commit(push) {
		renderFields();
		renderGrid();
		restart();
		writeAddress(push);
		updateShuffleState();
	}

	/* ---------------------------------------------------------- the defaults */

	/*
	 * A random pairing, drawn one from the faster half and one from the slower.
	 * Two sites picked at random are usually within a few hundred milliseconds of
	 * each other, which is not a race worth watching; and the alternative — always
	 * opening on the slowest site in the corpus — puts one name in a pillory on a
	 * page anyone can link to.
	 */
	/*
	 * Whether a random pairing may offer this site.
	 *
	 * The categories held back from the home page's Perfect Scores board are held
	 * back here too — the maintainer's own pages, and starter templates whose
	 * demo pages are near-empty by design. A site in several categories counts if
	 * any one of them is drawable. Typing a name and linking to a slug are
	 * unaffected: this narrows what the page offers unprompted, not what it can
	 * show.
	 */
	/*
	 * Same capture as the rest of the field.
	 *
	 * The hard rule on this page. An unthrottled strip is a full-speed load and a
	 * throttled one is a slow connection; put them in adjacent lanes and the
	 * picture says one site is far quicker when all it had was a faster link.
	 * Nothing in the frames reveals which is which, so the comparison has to
	 * refuse the pairing rather than caption it.
	 *
	 * A strip with no recorded method — stored before the field existed — counts
	 * as unthrottled, which is what it was: everything measured so far ran under
	 * Lighthouse's simulated default.
	 */
	function matchesCapture(site) {
		return (site.throttled === true) === captureMode;
	}

	/*
	 * What a draw can actually offer, category aside: the right capture, and a
	 * strip worth animating.
	 *
	 * The category menu counts with this too, so the number beside a category is
	 * the number of lanes it can fill. Counting plain membership instead made the
	 * menu promise more than the pool held — Developer Tooling read 96 against 91
	 * drawable — and Shuffle then disabled itself at a lane count the menu said
	 * was fine.
	 */
	function drawable(site) {
		return matchesCapture(site) && typeof settledAt(site) === "number" && site.distinct > 1;
	}

	function inChosenCategory(site) {
		var groups = site.groups || [];
		if (shuffleCategory) return groups.indexOf(shuffleCategory) >= 0;
		if (!categories.length) return true;
		for (var i = 0; i < groups.length; i++) {
			if (categoryIndex(groups[i]) >= 0) return true;
		}
		return false;
	}

	function inShufflePool(site) {
		return drawable(site) && inChosenCategory(site);
	}

	function categoryIndex(id) {
		for (var i = 0; i < categories.length; i++) {
			if (categories[i].id === id) return i;
		}
		return -1;
	}

	/* Only categories with enough racers to make a race — a name in the list that
	   cannot fill two lanes is a dead end. */
	/* Only sites of the current capture are offered by name, so a typed lane
	   cannot land the field in a mixed comparison. */
	function fillCatalogList() {
		catalogList.innerHTML = "";
		catalog.forEach(function (site) {
			if (!matchesCapture(site)) return;
			var option = el("option");
			option.value = site.name;
			catalogList.appendChild(option);
		});
	}

	/*
	 * Show the capture control only when there is a choice to make.
	 *
	 * Everything measured so far ran unthrottled, so until some of the corpus is
	 * re-measured the other option leads to an empty field. The control appears
	 * on its own the first time both kinds exist.
	 */
	/* Which account of the frames is showing — see the note markup. */
	function setCaptureCopy() {
		var unthrottled = document.getElementById("race-note-unthrottled");
		var throttled = document.getElementById("race-note-throttled");
		if (!unthrottled || !throttled) return;
		unthrottled.hidden = captureMode;
		throttled.hidden = !captureMode;
	}

	function setUpCaptureControl() {
		var fieldset = document.getElementById("race-throttle");
		if (!fieldset) return;

		var throttled = catalog.filter(function (s) { return s.throttled === true; }).length;
		var unthrottled = catalog.length - throttled;

		/* How much is behind each option, so an empty-looking side is explained
		   rather than mysterious mid-rollout. */
		fieldset.querySelectorAll(".race-throttle-count").forEach(function (span) {
			span.textContent = "(" + (span.dataset.capture === "true" ? throttled : unthrottled) + ")";
		});

		/*
		 * Always shown, both options, whatever they hold.
		 *
		 * Hiding the control while one side was empty made the distinction itself
		 * invisible — nothing on the page said these frames were unthrottled, or
		 * that throttled ones were a thing that could exist. An option with nothing
		 * behind it is shown with its zero and disabled rather than removed, so the
		 * choice is visible before it is available.
		 */
		fieldset.hidden = false;

		// Land on a side that has something, whatever a link asked for.
		if ((captureMode ? throttled : unthrottled) === 0) captureMode = throttled > 0;

		fieldset.querySelectorAll("input").forEach(function (input) {
			var count = input.value === "true" ? throttled : unthrottled;
			input.disabled = count === 0;
			input.closest("label").classList.toggle("is-empty", count === 0);
			input.checked = (input.value === "true") === captureMode;
			input.addEventListener("change", function () {
				if (!this.checked) return;
				captureMode = this.value === "true";
				setCaptureCopy();
				fillCatalogList();
				fillCategorySelect();
				shuffle();
			});
		});
	}

	function fillCategorySelect() {
		var select = document.getElementById("race-category");
		if (!select) return;

		/* Rebuilt whenever the capture changes: a category with ten unthrottled
		   sites may have none of the other kind, and offering it would be a menu
		   entry that empties the field. */
		select.innerHTML = "";
		shuffleCategory = "";
		var all = el("option");
		all.value = "";
		all.textContent = "all categories";
		select.appendChild(all);

		categories.forEach(function (category) {
			var count = 0;
			catalog.forEach(function (site) {
				if (!drawable(site)) return;
				if ((site.groups || []).indexOf(category.id) >= 0) count += 1;
			});
			/* One is enough to list. A single-site field is a real state now — the
			   lane fills and the second row stays empty — and hiding every category
			   until two exist left the menu blank on a capture that has one. */
			if (!count) return;

			var option = el("option");
			option.value = category.id;
			option.textContent = category.name + " (" + count + ")";
			select.appendChild(option);
		});

		/* Picking a category is asking to see that category, so it draws a field
		   straight away rather than arming a button to be pressed next. */
		/* Assigned rather than added: this runs again on every capture change, and
		   addEventListener would stack a handler per rebuild. */
		select.onchange = function () {
			shuffleCategory = this.value;
			shuffle();
		};
	}

	/* However many lanes are open stay open — shuffling is a reroll of the field,
	   not a reset of it. */
	/*
	 * Lanes a shuffle has to leave alone: locked, and still of the capture being
	 * compared. A lock does not outrank the capture rule — a locked unthrottled
	 * lane cannot stay in a throttled field — so one that no longer matches is
	 * released rather than kept.
	 */
	function keptLanes(count) {
		var kept = [];
		for (var i = 0; i < count; i++) {
			var lane = lanes[i];
			kept.push(lane && lane.locked && matchesCapture(lane.site) ? lane : null);
		}
		return kept;
	}

	/* Everything a draw must not pick: the sites already locked in place. */
	function takenBy(kept) {
		var taken = {};
		kept.forEach(function (lane) { if (lane) taken[lane.site.slug] = true; });
		return taken;
	}

	/*
	 * Reroll the unlocked lanes, leaving locked ones exactly where they are.
	 *
	 * However many lanes are open stay open — shuffling is a reroll of the field,
	 * not a reset of it. The draw is from the category's pool less anything
	 * already locked, so a locked site is never also drawn beside itself.
	 *
	 * A pool no bigger than the open slots is not something to shuffle: every
	 * draw returns the same sites, so the button would only reorder lanes and
	 * claim to have found something. Those slots take the pool whole instead —
	 * however few that is — and nothing happens if that is already on screen.
	 */
	function shuffle() {
		var count = Math.max(2, lanes.length);
		var kept = keptLanes(count);
		var open = kept.filter(function (lane) { return !lane; }).length;
		if (!open) return;

		var taken = takenBy(kept);
		var pool = shufflePool().filter(function (site) { return !taken[site.slug]; });
		var draws = pool.length <= open ? pool.slice() : randomLanes(open, taken);

		var next = [];
		var d = 0;
		for (var i = 0; i < count; i++) {
			if (kept[i]) next.push(kept[i]);
			else if (d < draws.length) next.push({ site: draws[d++], locked: false });
		}

		if (sameSites(next.map(function (lane) { return lane.site; }), lanes)) return;
		lanes = next;
		commit(true);
	}

	/*
	 * Off when pressing it could not produce a different field.
	 *
	 * Two ways that happens. Fewer eligible sites than lanes and a draw cannot
	 * even fill them, so shuffling would shrink the field rather than change it.
	 * Exactly as many and every draw returns the same set, so once those sites
	 * are showing there is nothing left to find — see `shuffle`.
	 */
	function updateShuffleState() {
		var button = document.getElementById("race-shuffle");
		if (!button) return;

		var count = Math.max(2, lanes.length);
		var kept = keptLanes(count);
		var open = kept.filter(function (lane) { return !lane; }).length;
		if (!open) {
			// Every lane is locked: there is nothing for a shuffle to touch.
			button.disabled = true;
			return;
		}

		var taken = takenBy(kept);
		var pool = shufflePool().filter(function (site) { return !taken[site.slug]; });
		var loose = lanes.filter(function (lane) { return !lane.locked; });
		button.disabled = pool.length < open || (pool.length === open && sameSites(pool, loose));
	}

	/*
	 * `count` sites spread across the range, one drawn at random from each band.
	 *
	 * The spread is the point: sites picked uniformly are usually within a few
	 * hundred milliseconds of each other, which is not a race worth watching.
	 * Sorting by settle time and taking one from each of `count` equal bands
	 * generalises the fast-against-slow pairing to however many lanes are open.
	 */
	/*
	 * The site a race opens against: this one.
	 *
	 * Held by slug rather than by name, since the slug is what the address uses
	 * and what survives a display name changing. Null if it has no filmstrip yet,
	 * which drops the page back to a random pairing rather than to an empty lane.
	 */
	var HOME_SLUG = "www-speedlify-dev";

	function homeSite() {
		return bySlug.get(HOME_SLUG) || null;
	}

	/* The opening field: this site against someone, so the page always shows the
	   same question being asked of a different answer. */
	function openingLanes() {
		var home = homeSite();
		if (!home || !matchesCapture(home)) return randomLanes(2);

		var others = randomLanes(2).filter(function (site) { return site !== home; });
		return others.length ? [home, others[0]] : randomLanes(2);
	}

	/* Everything a random draw is allowed to pick from, under the current
	   category. Named because the count matters as well as the contents — see
	   `shuffle`. */
	function shufflePool() {
		return catalog.filter(inShufflePool);
	}

	function sameSites(sites, currentLanes) {
		if (sites.length !== currentLanes.length) return false;
		var here = {};
		currentLanes.forEach(function (lane) { here[lane.site.slug] = true; });
		return sites.every(function (site) { return here[site.slug]; });
	}

	function randomLanes(count, exclude) {
		exclude = exclude || {};
		var free = function (site) { return !exclude[site.slug]; };

		var usable = shufflePool().filter(free);
		/* Widening past the category is fine; widening past the capture is not —
		   that is the one boundary the field cannot straddle, so a thin pool
		   returns short rather than borrowing from the other side. */
		if (usable.length < count) usable = catalog.filter(matchesCapture).filter(free);
		if (usable.length <= count) return usable.slice();

		var sorted = usable.slice().sort(function (a, b) {
			return settledAt(a) - settledAt(b);
		});

		var band = sorted.length / count;
		var picked = [];
		var taken = {};

		for (var i = 0; i < count; i++) {
			var lo = Math.floor(i * band);
			var hi = Math.max(lo + 1, Math.floor((i + 1) * band));
			var pick = null;

			for (var tries = 0; tries < 20 && !pick; tries++) {
				var candidate = sorted[lo + Math.floor(Math.random() * (hi - lo))];
				if (candidate && !taken[candidate.slug]) pick = candidate;
			}
			/* A band can be all duplicates of something already taken when the pool
			   is small; anything unused keeps the lane count intact. */
			if (!pick) {
				for (var j = 0; j < sorted.length && !pick; j++) {
					if (!taken[sorted[j].slug]) pick = sorted[j];
				}
			}
			if (pick) {
				taken[pick.slug] = true;
				picked.push(pick);
			}
		}

		return picked;
	}

	/*
	 * Lanes for a list of sites.
	 *
	 * A link naming exactly one site is a request to compare that site, so its
	 * lane starts locked: Shuffle then finds it opponents rather than replacing
	 * it, which is the only reading of "compare this" that the button can honour.
	 * The site page's filmstrip section links this way.
	 */
	function lanesFor(sites, fromLink) {
		var single = fromLink && sites.length === 1;
		return sites.map(function (site) { return { site: site, locked: single }; });
	}

	function fromAddress() {
		var picked = readAddress()
			.map(function (slug) { return bySlug.get(slug); })
			.filter(Boolean)
			.slice(0, MAX_LANES);
		if (!picked.length) return null;

		/* A link decides its own capture: the first lane sets it and the rest have
		   to match, so a hand-written address cannot open a mixed field. */
		captureMode = picked[0].throttled === true;
		picked = picked.filter(matchesCapture);
		/* One is a valid field — see `shuffle`. Zero is not a link worth honouring. */
		return picked.length ? picked : null;
	}

	/* ------------------------------------------------------------------ boot */

	function start(data) {
		catalog = (data && data.sites) || [];
		categories = (data && data.categories) || [];
		if (catalog.length < 2) {
			fail("No filmstrips have been captured yet, so there is nothing to race.");
			return;
		}

		catalog.forEach(function (site) {
			bySlug.set(site.slug, site);
			byName.set(site.name.toLowerCase(), site);
		});
		fillCatalogList();

		count.textContent = catalog.length + " sites have a filmstrip to race.";

		var initial = fromAddress();
		lanes = lanesFor(initial || openingLanes(), Boolean(initial));

		setUpCaptureControl();
		setCaptureCopy();
		fillCatalogList();
		fillCategorySelect();
		applySpeed();

		fallback.hidden = true;
		root.hidden = false;

		commit(false);
		bind();
	}

	function fail(message) {
		document.getElementById("race-fallback-text").textContent = message;
	}

	function bind() {
		/* The picker is a form for the sake of the controls in it, not to be
		   submitted: Enter in a lane input would otherwise reload the page onto a
		   query with no `sites` in it at all. */
		document.getElementById("race-picker").addEventListener("submit", function (event) {
			event.preventDefault();
		});

		playButton.addEventListener("click", function () {
			if (playing) pause();
			else play();
		});

		document.getElementById("race-restart").addEventListener("click", restart);

		document.getElementById("race-speed").addEventListener("change", function () {
			speed = parseFloat(this.value) || 1;
			/* Rebased so the change takes effect from here rather than replaying
			   the elapsed time at the new rate. */
			lastFrameTime = 0;
			/* Replaced rather than pushed: changing pace mid-race is not a place to
			   come Back to, and it would otherwise stack an entry per adjustment. */
			writeAddress(false);
		});

		document.getElementById("race-add").addEventListener("click", function () {
			if (lanes.length >= MAX_LANES) return;
			var taken = {};
			slugs().forEach(function (s) { taken[s] = true; });
			var free = catalog.filter(function (s) { return !taken[s.slug] && inShufflePool(s); });
			if (!free.length) return;
			lanes.push({ site: free[Math.floor(Math.random() * free.length)] });
			commit(true);
		});

		document.getElementById("race-shuffle").addEventListener("click", shuffle);

		scrub.addEventListener("input", function () {
			pause();
			follow = true;
			setTime((parseInt(this.value, 10) / 1000) * timeline.end);
		});

		/* Scrolling by hand is a decision to look somewhere; the playhead stops
		   dragging the view back until the race is restarted. */
		["wheel", "touchstart", "pointerdown"].forEach(function (type) {
			scroll.addEventListener(type, function () { follow = false; }, { passive: true });
		});

		/* The address is the state, so Back has to mean something here. */
		window.addEventListener("popstate", function () {
			applySpeed();
			var picked = fromAddress();
			if (!picked) return;
			lanes = lanesFor(picked, true);
			renderFields();
			renderGrid();
			restart();
		});

		/* Asking for less motion is not asking for an empty page: the race is laid
		   out finished instead, which is the same information without the
		   animation. The controls still work if it is wanted. */
		watchVisibility();

		var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)");
		if (reduced && reduced.matches) {
			follow = false;
			setTime(timeline.end);
			renderResult(rank());
			playButton.textContent = "Start";
		} else {
			play();
		}
	}

	fetch("/api/race.json")
		.then(function (response) {
			if (!response.ok) throw new Error(response.status);
			return response.json();
		})
		.then(start)
		.catch(function () {
			fail("The list of filmstrips could not be loaded, so the race cannot start. Each site's own filmstrip is on its site page.");
		});
})();
</script>
