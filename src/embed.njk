---
layout: base.njk
permalink: /embed/index.html
title: Embed
---

<header class="detail-head">
	<h2 class="page-hed">Embed a score</h2>
	<p class="lede">
		A standalone custom element that shows one site's Lighthouse scores and
		links to its full report. Drop it on any page — it needs nothing but the
		script and this instance's URL.
	</p>
</header>

<script type="module" src="/js/speedlify2-score.js"></script>

{% set measured = [] %}
{% for entry in sites.entries %}
	{% if entry.latest %}{% set measured = (measured.push(entry), measured) %}{% endif %}
{% endfor %}

{# The pinned URL is looked up rather than trusted, so it falls back to the first measured site if it leaves the corpus. #}
{% set pinned = [] %}
{% for entry in measured %}
	{% if entry.url == "https://arielsalminen.com/" %}{% set pinned = (pinned.push(entry), pinned) %}{% endif %}
{% endfor %}
{% set featured = pinned[0] or measured[0] %}

{# Every site with an embed, with the featured site first as the default; same rule as src/site-filmstrip.11tydata.js. #}
{% set strips = [] %}
{% set stripSlugs = [] %}
{% for entry in [featured].concat(measured) %}
	{% if entry.filmstrip and entry.filmstrip.distinct > 1 and not entry.interstitial and entry.slug not in stripSlugs %}
		{% set strips = (strips.push(entry), strips) %}
		{% set stripSlugs = (stripSlugs.push(entry.slug), stripSlugs) %}
	{% endif %}
{% endfor %}

{% from "contents.njk" import contents %}
{% set toc = [
	{ id: "try", label: "Live preview" },
	{ id: "usage", label: "Usage" },
	{ id: "finding-data", label: "How it finds the data" }
] %}
{% if strips.length %}{% set toc = (toc.push({ id: "filmstrip", label: "Filmstrip" }), toc) %}{% endif %}
{{ contents(toc) }}

<section class="panel" id="try">
	<h2>Live preview</h2>
	<p class="muted small">
		Pick any measured site, or type a URL, to see the component as it renders
		against this instance. Hover or tab to the scores to see its summary.
	</p>

	{% if featured %}
	<form class="race-picker embed-picker" id="score-embed-picker" autocomplete="off">
		<fieldset disabled title="Choosing a site needs JavaScript.">
			<div class="race-field">
				<label class="race-field-label" for="score-embed-site">Site</label>
				<input class="race-field-input" id="score-embed-site" type="url" list="score-embed-catalog" value="{{ featured.url }}">
			</div>
			<datalist id="score-embed-catalog">
				{% for entry in measured | sort(false, false, "displayUrl") %}<option value="{{ entry.url }}"></option>{% endfor %}
			</datalist>
		</fieldset>
	</form>
	<p class="embed-live" id="score-embed-preview">
		<speedlify2-score speedlify-url="{{ '/' | htmlBaseUrl }}" url="{{ featured.url }}"></speedlify2-score>
	</p>
	<pre><code id="score-embed-code" data-origin="{{ meta.url }}/">&lt;speedlify2-score speedlify-url="{{ meta.url }}/" url="{{ featured.url }}"&gt;&lt;/speedlify2-score&gt;</code></pre>
	<script>
	(function () {
		var form = document.getElementById("score-embed-picker");
		var input = document.getElementById("score-embed-site");
		var preview = document.getElementById("score-embed-preview");
		var code = document.getElementById("score-embed-code");
		var fieldset = form.querySelector("fieldset");

		// The component reads its attributes once when connected, so a new site gets a new element.
		function choose(url, write) {
			var current = preview.querySelector("speedlify2-score");
			var next = document.createElement("speedlify2-score");
			next.setAttribute("speedlify-url", current.getAttribute("speedlify-url"));
			next.setAttribute("url", url);
			current.replaceWith(next);
			input.value = url;
			code.textContent = '<speedlify2-score speedlify-url="' + code.dataset.origin + '" url="' + url + '"></speedlify2-score>';
			if (write) {
				var address = new URL(location.href);
				address.searchParams.set("url", url);
				address.hash = "try";
				history.replaceState(null, "", address);
			}
		}

		function parse(value) {
			try {
				var url = new URL(value.trim());
				return /^https?:$/.test(url.protocol) ? url.href : null;
			} catch (e) {
				return null;
			}
		}

		input.addEventListener("change", function () {
			var url = parse(input.value);
			if (url) {
				input.removeAttribute("aria-invalid");
				choose(url, true);
			} else {
				input.setAttribute("aria-invalid", "true");
			}
		});
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		});

		var linked = parse(new URLSearchParams(location.search).get("url") || "");
		if (linked) choose(linked, false);

		fieldset.disabled = false;
		fieldset.removeAttribute("title");
	})();
	</script>
	{% endif %}
</section>

<section class="panel" id="usage">
	<h2>Usage</h2>

	<p>Install it from npm — this is the version you want, pinned and served from your own site:</p>

	<pre><code>npm install speedlify2-score</code></pre>

	<p>Import it once, anywhere in your bundle. The element registers itself:</p>

	<pre><code>import "speedlify2-score";</code></pre>

	<p class="muted small">
		Zero dependencies, one file, and a standard ES module, so no build step is
		required. <a href="https://www.npmjs.com/package/speedlify2-score">speedlify2-score on npm</a> ·
		<a href="https://github.com/zachleat/speedlify2/tree/main/packages/speedlify2-score">source</a>
	</p>

	<p>
		Or skip the install and download the file manually:
		<a href="{{ meta.url }}/js/speedlify2-score.js"><code>{{ meta.url }}/js/speedlify2-score.js</code></a>
	</p>

	<div class="notice notice-warn">
		<strong>It would be unwise to hotlink the speedlify2-score component script.</strong>
		<p>
			Third party JavaScript is a big no-no! Hotlinking this copy also carries no versioning, no deprecation
			policy and no uptime commitment: the file can change shape, move or stop
			being served at any time, and a page embedding it directly would <strong>break with it and with no notice.</strong>
			Installing from npm gives you a version you control.
		</p>
	</div>

	<p>However you load it, the markup is the same:</p>

	<pre><code>&lt;!-- If you are not bundling, point this at your own copy --&gt;
&lt;script type="module" src="speedlify2-score.js"&gt;&lt;/script&gt;

&lt;!-- Scores for the page it sits on --&gt;
&lt;speedlify2-score speedlify-url="{{ meta.url }}/"&gt;&lt;/speedlify2-score&gt;

&lt;!-- Or a specific URL --&gt;
&lt;speedlify2-score speedlify-url="{{ meta.url }}/" url="https://example.com/"&gt;&lt;/speedlify2-score&gt;</code></pre>

	<h3>Attributes</h3>
	<p class="muted small">
		Two, and one of them is optional. There is nothing to configure about the
		output: every instance renders the same six circles — the four Lighthouse
		categories, Core Web Vitals, and axe violations — so a page carrying
		several reads as one table rather than a row of different shapes.
		Everything else is one click away in the full report.
	</p>
	<div class="table-scroll">
	<table class="grid">
		<thead>
			<tr><th class="col-site">Attribute</th><th class="col-site">Effect</th></tr>
		</thead>
		<tbody>
			<tr><td class="col-site"><code>speedlify-url</code></td><td class="col-site">Required. This instance's URL.</td></tr>
			<tr><td class="col-site"><code>url</code></td><td class="col-site">Which site to show. Defaults to the current page.</td></tr>
		</tbody>
	</table>
	</div>
</section>

<section class="panel" id="finding-data">
	<h2>How it finds the data</h2>
	<p class="muted small">
		There is no index to download. The component slugifies the URL in the
		browser with the same rules the generator uses and fetches
		<code>/api/site/&lt;slug&gt;.json</code> directly. One request, under a
		kilobyte, for exactly the site being shown.
	</p>
	<p class="muted small">
		Several components on one page share a single fetch per URL. Normalization
		matches the generator's, so <code>https://Example.com</code> and
		<code>https://example.com/</code> resolve to the same record.
	</p>
	<p class="muted small">
		Working out the filename is string manipulation, not cryptography, so the
		component needs no secure context and runs on a page served over plain
		http. If two sites ever claim one slug, both are published under a hash
		instead and read here as unmeasured — a miss rather than another site's
		numbers.
	</p>
	<p class="muted small">
		<a href="/api/site/{{ featured.slug }}.json">See {{ featured.displayUrl }}'s data file</a>
	</p>
</section>

{% if strips.length %}
{% set strip = strips[0] %}
<section class="panel" id="filmstrip">
	<h2>Embed a filmstrip</h2>
	<p class="muted small">
		Any site with a filmstrip on its site page has an animated copy of it at
		<code>/site/&lt;slug&gt;/filmstrip/</code>, sized for an iframe. It needs no
		script on your page, and plays once it scrolls into view. Add
		<code>?theme=light</code> or <code>?theme=dark</code> to override the
		reader's system theme.
	</p>
	{# Disabled until scripted, like the masthead's category switcher. #}
	<form class="race-picker embed-picker" id="filmstrip-embed-picker" autocomplete="off">
		<fieldset disabled title="Choosing a site needs JavaScript.">
			<div class="race-field">
				<label class="race-field-label" for="filmstrip-embed-site">Site</label>
				<input class="race-field-input" id="filmstrip-embed-site" type="text" list="filmstrip-embed-catalog" value="{{ strip.displayUrl }}">
			</div>
			<datalist id="filmstrip-embed-catalog">
				{% for entry in strips | sort(false, false, "displayUrl") %}<option value="{{ entry.displayUrl }}" data-slug="{{ entry.slug }}"></option>{% endfor %}
			</datalist>
		</fieldset>
	</form>
	<iframe class="filmstrip-embed-frame" id="filmstrip-embed-frame" src="/site/{{ strip.slug }}/filmstrip/" title="{{ strip.displayUrl }} filmstrip" loading="lazy"
		data-base="{{ '/' | htmlBaseUrl }}"></iframe>
	<pre><code id="filmstrip-embed-code" data-origin="{{ meta.url }}/">&lt;iframe src="{{ meta.url }}/site/{{ strip.slug }}/filmstrip/" title="{{ strip.displayUrl }} filmstrip" width="100%" height="420" style="border: 0" loading="lazy"&gt;&lt;/iframe&gt;</code></pre>
	<script>
	(function () {
		var form = document.getElementById("filmstrip-embed-picker");
		var input = document.getElementById("filmstrip-embed-site");
		var frame = document.getElementById("filmstrip-embed-frame");
		var code = document.getElementById("filmstrip-embed-code");
		var options = document.querySelectorAll("#filmstrip-embed-catalog option");
		var fieldset = form.querySelector("fieldset");

		function find(typed) {
			typed = typed.trim().toLowerCase();
			for (var i = 0; i < options.length; i++) {
				if (options[i].value.toLowerCase() === typed || options[i].dataset.slug === typed) return options[i];
			}
			return null;
		}

		function choose(option, write) {
			var slug = option.dataset.slug;
			var name = option.value;
			var path = "site/" + slug + "/filmstrip/";
			input.value = name;
			input.removeAttribute("aria-invalid");
			frame.src = frame.dataset.base + path;
			frame.title = name + " filmstrip";
			code.textContent = '<iframe src="' + code.dataset.origin + path + '" title="' + name + ' filmstrip" width="100%" height="420" style="border: 0" loading="lazy"></iframe>';
			if (write) {
				var url = new URL(location.href);
				url.searchParams.set("site", slug);
				url.hash = "filmstrip";
				history.replaceState(null, "", url);
			}
		}

		input.addEventListener("change", function () {
			var option = find(input.value);
			if (option) choose(option, true);
			else input.setAttribute("aria-invalid", "true");
		});
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		});

		var linked = find(new URLSearchParams(location.search).get("site") || "");
		if (linked) choose(linked, false);

		fieldset.disabled = false;
		fieldset.removeAttribute("title");
	})();
	</script>
</section>
{% endif %}
