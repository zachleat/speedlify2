---
layout: base.njk
permalink: /charts/index.html
title: Charts
---

<header class="detail-head">
	<h2 class="page-hed">Charts</h2>
	<p class="lede">
		Pulls the most recent measurement of every site (excluding starter projects). Tooltips are only shown on green (well scoring) data points.
	</p>
</header>

{% from "scatter.njk" import scatterfigure %}
{% from "strip.njk" import stripfigure %}

{#
	Built rather than written out, so a chart that has no data to draw drops out
	of the list instead of leaving a link to a section that is not on the page.
#}
{% set toc = [] %}
{% if sites.lcpScatter %}{% set toc = (toc.push({ id: "weight-lcp", label: "Page Weight" }), toc) %}{% endif %}
{% if sites.jsScatter %}{% set toc = (toc.push({ id: "js-lcp", label: "JavaScript Weight" }), toc) %}{% endif %}
{% if sites.ttfbScatter %}{% set toc = (toc.push({ id: "ttfb-lcp", label: "Time to First Byte" }), toc) %}{% endif %}
{% if sites.fontClsScatter %}{% set toc = (toc.push({ id: "font-cls", label: "Fonts and Layout Shift" }), toc) %}{% endif %}
{% if sites.thirdPartyScatter %}{% set toc = (toc.push({ id: "third-party", label: "Third Party" }), toc) %}{% endif %}
{% if sites.jsByGenerator %}{% set toc = (toc.push({ id: "js-by-generator", label: "JavaScript by Generator" }), toc) %}{% endif %}
{% if sites.clientRenderedByGenerator %}{% set toc = (toc.push({ id: "client-rendered", label: "Client Rendering by Generator" }), toc) %}{% endif %}
{% if sites.ttfbByHost %}{% set toc = (toc.push({ id: "ttfb-by-host", label: "TTFB by Host" }), toc) %}{% endif %}
{% if sites.labFieldPairs %}{% set toc = (toc.push({ id: "lab-field", label: "Lab vs Field LCP" }), toc) %}{% endif %}

{% if toc.length > 1 %}
<nav class="contents contents-sticky" aria-label="On this page">
	<span class="contents-label">On this page</span>
	<ul>
		{% for item in toc %}
		<li><a href="#{{ item.id }}">{{ item.label }}</a></li>
		{% endfor %}
	</ul>
</nav>
{% endif %}

{% if sites.lcpScatter %}
{% set plot = sites.lcpScatter %}
<section class="group" id="weight-lcp">
	<div class="group-head">
		<h2>Page Weight vs LCP <span class="tag">{{ plot.count | num }} sites</span></h2>
	</div>
	{{ scatterfigure(plot, "Page Weight") }}
</section>
{% endif %}

{% if sites.jsScatter %}
{% set js = sites.jsScatter %}
<section class="group" id="js-lcp">
	<div class="group-head">
		<h2>JavaScript Weight vs LCP <span class="tag">{{ js.count | num }} sites</span></h2>
	</div>
	{{ scatterfigure(js, "JavaScript Weight") }}
</section>
{% endif %}

{% if sites.ttfbScatter %}
{% set ttfb = sites.ttfbScatter %}
<section class="group" id="ttfb-lcp">
	<div class="group-head">
		<h2>TTFB vs LCP <span class="tag">{{ ttfb.count | num }} sites</span></h2>
	</div>
	{{ scatterfigure(ttfb, "Time to First Byte") }}
</section>
{% endif %}

{% if sites.fontClsScatter %}
{% set fonts = sites.fontClsScatter %}
<section class="group" id="font-cls">
	<div class="group-head">
		<h2>Web Font Weight vs CLS <span class="tag">{{ fonts.count | num }} sites</span></h2>
	</div>
	{{ scatterfigure(fonts, "Web Font Weight", "Cumulative Layout Shift") }}
</section>
{% endif %}

{% if sites.thirdPartyScatter %}
{% set tp = sites.thirdPartyScatter %}
<section class="group" id="third-party">
	<div class="group-head">
		<h2>Third Party vs Performance <span class="tag">{{ tp.count | num }} sites</span></h2>
	</div>
	<p class="muted small">
		Usually things like analytics, embeds, fonts, tag managers, ads weighted against Lighthouse’s Performance score.
	</p>
	{{ scatterfigure(tp, "Third-Party Weight", "Performance Score") }}
</section>
{% endif %}

{% if sites.jsByGenerator %}
{% set jg = sites.jsByGenerator %}
<section class="group" id="js-by-generator">
	<div class="group-head">
		<h2>JavaScript Weight by Site Generator <span class="tag">{{ jg.count | num }} sites</span></h2>
	</div>
	<p class="muted small">
		One row per generator, one dot per site, ordered by median.
	</p>
	{#
		The caveat is not a footnote. Eleventy is four fifths of the sites that
		report a generator here, and every other row is a handful of sites that
		someone chose to submit to an Eleventy project. Read down the column of
		counts before reading across the rows.
	#}
	<p class="muted small">
		Across {{ jg.groups }} generators with at least five sites each:
		twenty more were detected too rarely in this data set.
	</p>

	{{ stripfigure(jg, "JavaScript Weight", true) }}
</section>
{% endif %}

{% if sites.clientRenderedByGenerator %}
{% set cr = sites.clientRenderedByGenerator %}
<section class="group" id="client-rendered">
	<div class="group-head">
		<h2>Client Rendering by Generator <span class="tag">{{ cr.judged | num }} sites</span></h2>
	</div>
	<p class="muted small">
		Sites that painted nothing with scripts disabled, by the tool their page
		reports building it. The pale bar is every site judged; the solid one is
		how many of them came up blank.
	</p>
	{#
		Three caveats, and none of them is a footnote.

		The first is coverage: only a site with a no-JS capture can be judged, and
		which sites have one is a property of the category, not of the site. This
		is a slice of the corpus, not a census of it.

		The second is that the largest row is not a tool. A page that renders
		nothing server-side often ships no build-time generator tag either — the
		same property produces both — so "no generator tag" collects much of what
		this chart is looking for, and the tools named below it are the ones that
		did declare themselves.

		The third is scale: with a handful of flagged sites, one site moving is a
		visible change in a bar. The counts are printed beside every row for that
		reason.
	#}
	<p class="muted small">
		{{ cr.flagged }} empty pre-JavaScript blank pages from {{ cr.judged | num }} measured {{ cr.judged | plural("site") }}.
	</p>

	<ul class="crbars">
		{% for row in cr.rows %}
		<li class="crbar{% if not row.detected %} crbar-untagged{% endif %}">
			<span class="crbar-name">
				{% if row.icon %}{% stackIcon row %}{% endif %}{{ row.name }}
			</span>
			<span class="crbar-track" title="{{ row.flagged }} of {{ row.judged }} judged {{ row.judged | plural('site') }} drew nothing without JavaScript">
				<span class="crbar-judged" style="width: {{ row.judgedPct }}%">
					<span class="crbar-flagged" style="width: {% if row.judged %}{{ (row.flagged / row.judged * 100) | round(1) }}{% else %}0{% endif %}%"></span>
				</span>
			</span>
			<span class="crbar-count">{{ row.flagged }}<span class="muted">/{{ row.judged }}</span></span>
		</li>
		{% endfor %}
	</ul>
</section>
{% endif %}

{% if sites.ttfbByHost %}
{% set th = sites.ttfbByHost %}
<section class="group" id="ttfb-by-host">
	<div class="group-head">
		<h2>TTFB by Host <span class="tag">{{ th.count | num }} sites</span></h2>
	</div>
	{#
		Worth the number here more than anywhere: these medians sit within 1.5x of
		each other with the rows almost entirely overlapping, so the tick is the
		only thing telling one host from the next, and "almost the same" is exactly
		the finding.
	#}
	{{ stripfigure(th, "Time to First Byte", true) }}
</section>
{% endif %}

{% if sites.labFieldPairs %}
{% set lf = sites.labFieldPairs %}
<section class="group" id="lab-field">
	<div class="group-head">
		<h2>Lab vs Field LCP <span class="tag">{{ lf.count | num }} sites</span></h2>
	</div>
	<p class="muted small">
		One row per site: a dot for what our throttled lab run measured, a dot for
		what real users actually saw (Chrome&rsquo;s field p75) and a
		line joining them.
	</p>
	{#
		The sampling bias is the first thing to say, not a footnote. CrUX only
		reports sites with enough traffic to anonymize, so this is not a seventh of
		the corpus chosen at random — it is the popular seventh, which is likely
		the better-resourced one too. Any reading of the aggregate carries that.
	#}
	<p class="muted small">
		The lab is slower than reality on <strong>{{ lf.labSlower | num }}</strong>
		of these and faster on {{ lf.labFaster | num }}.
	</p>

	<figure class="plot">
		<div class="plot-frame">
		<svg viewBox="0 0 {{ lf.box.w }} {{ lf.box.h }}" role="img"
			aria-label="Lab and field largest contentful paint for {{ lf.count | num }} sites, each pair joined by a line. The lab figure is slower than the field figure on {{ lf.labSlower | num }} of them.">
			<g class="plot-grid">
				{%- for tick in lf.xTicks %}
				<line x1="{{ tick.x }}" x2="{{ tick.x }}" y1="{{ lf.box.top }}" y2="{{ lf.box.top + lf.plot.h }}"/>
				{%- endfor %}
			</g>

			<g class="plot-threshold">
				{%- for line in lf.thresholds %}
				<line x1="{{ line.x }}" x2="{{ line.x }}" y1="{{ lf.box.top }}" y2="{{ lf.box.top + lf.plot.h }}"/>
				<text x="{{ line.x + 5 }}" y="{{ lf.box.top + 12 }}" text-anchor="start">{{ line.label }}</text>
				{%- endfor %}
			</g>

			<g class="plot-axis">
				{%- for tick in lf.xTicks %}
				<text x="{{ tick.x }}" y="{{ lf.axis.tickY }}" text-anchor="middle">{{ tick.label }}</text>
				{%- endfor %}
			</g>
			<g class="plot-axis-title">
				<text x="{{ lf.axis.xLabel.x }}" y="{{ lf.axis.xLabel.y }}" text-anchor="middle">Largest Contentful Paint</text>
			</g>

			{#
				Lines first, then the lab dots, then the field dots on top — the
				field end is the one that carries the verdict, so nothing is allowed
				to sit over it.
			#}
			<g class="pair-links">
				{%- for pair in lf.pairs %}<line x1="{{ pair.labX }}" x2="{{ pair.fieldX }}" y1="{{ pair.y }}" y2="{{ pair.y }}"/>{% endfor %}
			</g>
			<g class="pair-lab">
				{%- for pair in lf.pairs %}<circle cx="{{ pair.labX }}" cy="{{ pair.y }}" r="2"/>{% endfor %}
			</g>
			{%- for band in ["poor", "average", "good"] %}
			<g class="pair-field plot-{{ band }}">
				{%- for pair in lf.pairs %}{% if pair.band == band %}<circle cx="{{ pair.fieldX }}" cy="{{ pair.y }}" r="2.2"/>{% endif %}{% endfor %}
			</g>
			{%- endfor %}
		</svg>

		{#
			One hit target per row rather than per dot: the pair is the unit being
			read, and a 4px row is already the smallest thing here worth aiming at.

			Only the rows real users found fast are named, as on every chart here.
			The others are still drawn, and still every bit as legible — they are
			simply not identified.
		#}
		<div class="plot-hits">
			{%- for pair in lf.pairs %}{% if pair.named %}
			<a class="plot-hit pair-hit{{ ' is-low' if pair.flipY }}"
				href="/site/{{ pair.slug }}/" style="top: {{ pair.py }}%; height: {{ lf.rowPct }}%"
				tabindex="-1" aria-hidden="true">
				<span class="plot-tip">
					<span class="plot-tip-name">{{ pair.name }}</span>
					<span class="plot-tip-stats">lab {{ pair.labText }} · field {{ pair.fieldText }}</span>
				</span>
			</a>
			{%- endif %}{% endfor %}
		</div>
		</div>

		<figcaption class="plot-legend">
			<span class="plot-key pair-key-lab">Lab</span>
			<span class="plot-key plot-good">Field, within 2.5&nbsp;s</span>
			<span class="plot-key plot-average">Field, to 4&nbsp;s</span>
			<span class="plot-key plot-poor">Field, over 4&nbsp;s</span>
		</figcaption>
	</figure>
</section>
{% endif %}
