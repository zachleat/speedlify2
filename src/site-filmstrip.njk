---
permalink: "/site/{{ entry.slug }}/filmstrip/"
eleventyExcludeFromCollections: true
---
{# The site page's filmstrip player alone, for an iframe; `?theme=light|dark` overrides the system theme. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="robots" content="noindex">
<title>{{ entry.displayUrl }} filmstrip · {{ meta.title }}</title>
<link rel="canonical" href="{{ meta.url }}/site/{{ entry.slug }}/">
<script>
try {
	var theme = new URLSearchParams(location.search).get("theme");
	if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
} catch (e) {}
</script>
{% if buildawesome.env.runMode == "build" %}
<style>{{ styleCss | safe }}</style>
{% else %}
<link rel="stylesheet" href="/css/style.css">
{% endif %}
</head>
<body class="filmstrip-embed">
<p class="filmstrip-embed-head">
	<a class="site-link" href="/site/{{ entry.slug }}/" target="_blank">
		{% set avatar = entry.url | avatar(meta.avatarService) %}
		{% if avatar %}<img class="favicon" src="{{ avatar }}" width="32" height="32" alt="" decoding="async">{% endif %}
		<span>{{ entry.displayUrl }}</span>
	</a>
	<span class="recents-dots" aria-hidden="true">
		{% for band in entry | ringBands %}<span class="recents-dot recents-dot-{{ band }}"></span>{% endfor %}
	</span>
	<a class="small filmstrip-embed-credit" href="/" target="_blank"><i class="fa-solid fa-forward-fast filmstrip-embed-mark" width="16" height="16" aria-hidden="true"></i>{{ meta.title }}</a>
</p>
{% set filmstripNoSpeed = true %}
{% include "filmstrip-player.njk" %}
{% getBundle "fontawesome" %}
</body>
</html>
