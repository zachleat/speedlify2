<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Dark first, matching `color-scheme: dark` on :root below. This is not a
     duplicate of that declaration: the CSS wins once it is parsed, but the UA
     reads this while the document is still arriving, so it governs the canvas
     and the scrollbar in the window before then — and, between pages, the
     background the browser paints for the incoming document. Both schemes are
     listed because both are real: a stored choice of "light" flips :root to
     color-scheme: light a few lines further down. -->
<meta name="color-scheme" content="dark light">
<!-- Safari tints its toolbar with this. The masthead is what sits under it —
     sticky, and painted `--surface` — so this tracks that.

     No `media="(prefers-color-scheme: …)"` pair, which is the usual way to write
     this: that only works for a site whose theme follows the OS, and this one is
     dark unconditionally until someone chooses otherwise. The value is kept in
     step by the script below instead. -->
<meta name="theme-color" content="#383838">
<title>{% if title %}{{ title }} · {% endif %}{{ meta.title }}</title>
<meta name="description" content="{{ description or meta.description }}">
<meta name="generator" content="{{ buildawesome.generator }}">
{% if buildawesome.env.runMode == "build" %}
<style>{% include "../css/style.css" %}</style>
{% else %}
<link rel="stylesheet" href="/css/style.css">
{% endif %}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>⚡</text></svg>">
<script>
/* Applied before first paint so a light-mode reader never sees a dark flash.
   Dark is the default; only a stored choice of "light" changes anything. */
try { if (localStorage.getItem("speedlify-theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
/* Read from the stylesheet rather than repeated here, so the toolbar cannot
   drift from the masthead when --surface changes. Safe this early: a script
   after a stylesheet waits for it, so the custom property already resolves. */
function speedlifyThemeColor() {
	try {
		var meta = document.querySelector('meta[name="theme-color"]');
		var surface = getComputedStyle(document.documentElement).getPropertyValue("--surface").trim();
		if (meta && surface) meta.setAttribute("content", surface);
	} catch (e) {}
}
speedlifyThemeColor();
</script>
</head>
<body>

<header class="masthead">
	<div class="wrap">
		<h1 class="masthead-hed"><a href="/">{{ meta.title }}</a></h1>
		{#
			The tagline, and nothing else. How much of the corpus has data is a fact
			about the instance rather than about the page you are on, so it reads as
			a colophon — see the footer.
		#}
		<p class="masthead-subhed">
			{#
				Trailing full stop trimmed: the sentence continues into the clause
				below, where `<meta name="description">` above wants it whole.
			#}
			{{ meta.description | replace(r/\.$/, "") }}
			{%- if sites.coverage.measured %} — measured continuously.{% else %}.{% endif %}
		</p>
		<div class="masthead-subhed masthead-tools">
			<a href="/runs/">Measurement runs</a>
			<a href="/embed/">Embed a score</a>
			<!-- Hidden until scripted: without JS the choice cannot be stored,
			     and a button that silently does nothing is worse than none. -->
			<button class="theme-toggle" type="button" id="theme-toggle" hidden>
			{#
				Font Awesome, via the transform — these become <use> references
				against the same spritesheet the stack marks use, so the two glyphs
				cost one symbol each across the whole site rather than a hand-drawn
				path in every page's <head>-adjacent markup.

				Empty, deliberately: the transform turns element content into a
				<title>, and the button already has visible text beside the icon.
			#}
			<i class="fa-solid fa-sun theme-icon theme-icon-sun" width="14" height="14" aria-hidden="true"></i>
			<i class="fa-solid fa-moon theme-icon theme-icon-moon" width="14" height="14" aria-hidden="true"></i>
			<span class="theme-toggle-text">Light mode</span>
		</button>
		{#
			Jump to a category, from any page.

			`method="get"` with nowhere to get to: this is a static site, so nothing
			turns `?group=hosts` into `/group/hosts/`. The action is the home page's
			Categories list, which is the honest destination for an unscripted
			submit — you asked to change category and you land on the list of them.
			The script below upgrades that to going straight there. The fragment
			survives because submission mutates only the query.

			Labelled by `aria-label` rather than a visible <label>: the control sits
			in a row of links where a word in front of it would read as another one.
		#}
		<form class="cat-switch" method="get" action="/#categories">
			<select id="cat-switch" name="group" aria-label="Jump to a category">
				{#
					A prompt only where nothing is selected. On a category page the
					current one is, so the control never opens claiming the reader is
					somewhere they are not.
				#}
				{% if not group %}<option value="" selected>Categories&hellip;</option>{% endif %}
				{#
					Two passes over the same list rather than one.

					A category kept off the home page's list is still reachable
					here — that is the point of the flag — but it belongs after the
					ones a reader arrived expecting, not interleaved with them. Two
					loops is the whole mechanism: Nunjucks has no sort-by-field that
					can be trusted for this (its `selectattr` ignores the test it is
					given), so anything cleverer would have to happen in the report.
				#}
				{% for g in sites.groups %}
					{% if g.showOnHomePageCategoryList %}
				<option value="{{ g.id }}"{% if group and g.id == group.id %} selected{% endif %}>{{ g.name }}</option>
					{% endif %}
				{% endfor %}
				{#
					A separator, not a label. `<hr>` in a `<select>` is in the spec and
					current browsers draw it as a rule; older ones ignore it, which is
					the right failure — the list still reads in the same order, just
					without the line.

					An `<optgroup>` was the alternative and says too much: these are not
					a kind of category, they are the ones kept off the front page, and
					naming that in the control would be explaining an editorial decision
					to someone who only wants to go somewhere.
				#}
				{% if sites.hasSecondaryCategories %}<hr>{% endif %}
				{% for g in sites.groups %}
					{% if not g.showOnHomePageCategoryList %}
				<option value="{{ g.id }}"{% if group and g.id == group.id %} selected{% endif %}>{{ g.name }}</option>
					{% endif %}
				{% endfor %}
			</select>
			{#
				The unscripted path. Hidden by the script below, which navigates on
				change and leaves nothing for it to do — the inverse of the theme
				toggle above, which is hidden until scripted for the same reason:
				a control that does nothing is worse than no control.
			#}
			<button type="submit">Go</button>
		</form>
		</div>
		<script>
		/* Upgrade the fallback submit into the navigation it wants to be. Also on
		   change, so a mouse needs one action rather than two. */
		(function () {
			var form = document.querySelector(".cat-switch");
			if (!form) return;
			var select = form.elements.group;
			function go(event) {
				var value = select.value;
				if (!value) return;
				event.preventDefault();
				location.href = "/group/" + encodeURIComponent(value) + "/";
			}
			form.addEventListener("submit", go);
			select.addEventListener("change", go);

			/* Nothing left for it to do once change navigates. Hidden here rather
			   than in CSS so it survives for anyone the script did not reach. */
			var submit = form.querySelector("button[type=submit]");
			if (submit) submit.hidden = true;
		})();
		</script>
	</div>
</header>

<main class="wrap">
	{{ content | safe }}
</main>

<footer class="footer">
	<div class="wrap">
		{#
			Build stamp and coverage in one line. Coverage moved down from the
			masthead: it is a status line about this instance, which belongs with
			the stamp and the source link rather than above every page's content.
		#}
		<p>
			Built <time datetime="{{ sites.generated | iso }}">{{ sites.generated | date("long") }}</time>{% if meta.repo %} ·
			<a href="{{ meta.repo }}">Source on GitHub</a>{% endif %}
			{%- if sites.coverage.measured %} ·
			<strong>{{ sites.coverage.measured }}/{{ sites.coverage.total }}</strong>
			{{ sites.coverage.measured | plural("site") }} {{ sites.coverage.measured | verb("has", "have") }} data
			{#- The running total, which used to head its own line above. It is a
			    fact about the same set of sites, so it reads as a gloss on the
			    coverage fraction rather than as a separate statistic. #}
			{%- if sites.stats.totalMeasurements %} ({{ sites.stats.totalMeasurements | num }} {{ sites.stats.totalMeasurements | plural("measurement") }}){% endif %}
			{%- if sites.coverage.medianAgeHours %}, median age
			{{ sites.coverage.medianAgeHours | duration }}
			{%- endif %}.
			{% if sites.coverage.stale %}<span class="worse">{{ sites.coverage.stale }} stale</span> (over {{ sites.coverage.staleAfterHours | duration }}).{% endif %}
			{% if sites.coverage.never %}<span class="muted">{{ sites.coverage.never }} not yet measured.</span>{% endif %}
			{% if sites.stats.failing %}<span class="failing-note"><em>{{ sites.stats.failing | num }} currently failing.</em></span>{% endif %}
			{%- endif %}
		</p>
		<p class="muted">
			Lab data from Lighthouse{% if sites.hasFieldData %}, field data from the Chrome UX Report (28-day trailing p75){% endif %}.
			Lab numbers are simulated on one machine and will vary from real user data.
		</p>
	</div>
</footer>

<script>
/* The only scripted behaviour on the site. Everything else — including the
   sparklines and score rings — is rendered at build time. */
(function () {
	var root = document.documentElement;
	var button = document.getElementById("theme-toggle");
	if (!button) return;

	// Only the text node is rewritten: the icons are siblings of it, and
	// assigning to button.textContent would remove them.
	var text = button.querySelector(".theme-toggle-text") || button;

	function label() {
		var light = root.dataset.theme === "light";
		text.textContent = light ? "Dark mode" : "Light mode";
		button.setAttribute("aria-pressed", String(light));
	}

	button.hidden = false;
	label();

	button.addEventListener("click", function () {
		var light = root.dataset.theme !== "light";
		if (light) root.dataset.theme = "light";
		else delete root.dataset.theme;

		try { localStorage.setItem("speedlify-theme", light ? "light" : "dark"); } catch (e) {}
		label();
		// Safari's toolbar follows the masthead across the switch too.
		if (typeof speedlifyThemeColor === "function") speedlifyThemeColor();
	});
})();
</script>

{#
	The Font Awesome spritesheet: one <symbol> for each mark this page actually
	uses, and nothing for the ones it does not. Last in the body because it is
	inert markup — the <use> references above resolve against it wherever it
	sits, and putting hundreds of path definitions ahead of the content would
	delay the content for no gain.

	Emitted unconditionally: the bundle is empty on a page with no icons, so
	there is nothing to branch on.
#}
{% getBundle "fontawesome" %}

</body>
</html>
