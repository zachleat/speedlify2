# Copy to `.env` — it is gitignored and loaded automatically by every command.
#
# Real environment variables take precedence, so a value set by your shell or by
# CI is never overwritten by this file. Everything here is optional.

# Google API key with the Chrome UX Report API enabled.
# Without it, field data is skipped entirely — including INP, which Lighthouse
# cannot measure in a lab run. Verify with `npx spdly check`.
# https://console.cloud.google.com/apis/credentials
CRUX_API_KEY=

# Where measurements are stored and read from.
# SPEEDLIFY_RESULTS_DIR=results

# Where NDJSON run logs are written.
# SPEEDLIFY_LOGS_DIR=logs

# Where `spdly report` writes, and where the Build Awesome build reads from.
# SPEEDLIFY_REPORT_FILE=report.json

# Load a different env file instead of `.env`.
# SPEEDLIFY_ENV_FILE=.env.local

# Deployed origin, used for absolute URLs in page metadata.
# SPEEDLIFY_SITE_URL=https://example.com

# Repository link shown in the site header.
# SPEEDLIFY_REPO_URL=https://github.com/you/spdly

# GoatCounter endpoint. Adds the counter script to every page; off when unset.
# SPEEDLIFY_GOATCOUNTER_URL=https://you.goatcounter.com/count
